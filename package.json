{
  "name": "obakeman",
  "productName": "Obakeman",
  "description": "Local-first technical interview practice.",
  "author": "Obakeman contributors",
  "version": "0.1.0",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "package": "npm run build && electron-builder --dir",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run package && playwright test",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "dev.obakeman.app",
    "productName": "Obakeman",
    "asar": true,
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.svg",
      "target": [
        "dir"
      ]
    },
    "linux": {
      "category": "Development",
      "icon": "build/icon.svg",
      "target": [
        "dir"
      ]
    },
    "win": {
      "icon": "build/icon.svg",
      "target": [
        "dir"
      ]
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "electron": "^42.11.16",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "@electron/get": {
      "undici": "7.30.1"
    }
  }
}
